#include<lpc21xx.h>
#include "can2_driver.h"
#include "delay.h"
#include "4_bit_lcd.h"

#define servo_min 1000    // 1.0 ms -90
#define servo_mid 1500    // 1.5 ms 0
#define servo_max 2000    // 2.0 ms +90

void pwm_init(void);
void servo_write(int angle);
void servo_move_smooth(int start, int end);
int current_angle=0;
int i;
int main()
{
	CAN2_MSG k1;
	pwm_init();
	can2_init();
	lcd_init();

    servo_write(servo_mid);
	delay_ms(500);
	lcd_cmd(0xcc);
	lcd_str("CLOSE");
	while(1)
	{
		can2_rx(&k1);
		lcd_cmd(0xc0);
		lcd_str("DOOR STATUS:");
		lcd_cmd(0x80);
		lcd_float(k1.byte_A);
		if(k1.id==0x002)
		{
				if((k1.byte_A>=35)&&(current_angle!=180))
				{
					lcd_cmd(0x01);
					lcd_cmd(0xcc);
					lcd_str("OPEN");
					servo_move_smooth(servo_mid,servo_max);
					current_angle=180;
				}
				else if((k1.byte_A<35)&&(current_angle!=0))
				{ 	
					lcd_cmd(0x01);
					lcd_cmd(0xcc);
					lcd_str("CLOSE");
					current_angle=0;		 
					servo_move_smooth(servo_max,servo_min);
    				//for(i=0;i<50;i++) delay_ms(10); 				// wait 2s
				}
				lcd_cmd(0xD4);
				lcd_str("----SMART WINDOW----");
				delay_ms(500);
		}	
	}
}
void pwm_init(void)
{
	PINSEL0 |=0X00000008;

	PWMTCR = (1<<1);
	PWMPR  = 60-1;
	PWMMR0 = 5000;
	PWMMR3 = servo_mid;
	PWMMCR = (1<<1);	       
    PWMLER = (1<<0)|(1<<3); // Latch MR0 & MR3    
    PWMPCR = 1<<11;
    PWMTCR = (1<<0)|(1<<3);	//ENABLE PWM 

}
void servo_write(int angle)
{
	PWMMR3  = angle;
	PWMLER  = 1<<3;
}
void servo_move_smooth(int start, int end)
{
	int pos;
    if(start < end)
    {
        servo_write(servo_max);
    }
    else
    {
        for(pos = start; pos >= end; pos -= 5)
        {
            PWMMR3 = pos;
            PWMLER = (1<<3);
            delay_ms(20);
        }
    }
}

